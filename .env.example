# API-Football — read by scripts/refresh-squad.mjs only.
# Key from https://dashboard.api-football.com (free tier: 100 requests/day).
#
# This is a build-time credential. Nothing in the deployed game reads it:
# the roster is committed in src/data/roster.js, so the site is static and
# needs no environment at all in production.
API_FOOTBALL_KEY=

# Only if you subscribe through RapidAPI rather than api-sports.io directly —
# the auth headers differ and the host tells them apart.
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
