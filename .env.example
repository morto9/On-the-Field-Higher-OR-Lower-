# API-Football — supplies squads, ages and player portraits.
# Key from https://dashboard.api-football.com (free tier: 100 requests/day).
#
# Without this the game still runs: /api/squad reports source:"static" and the
# browser plays off the roster committed in src/data/squad.js.
API_FOOTBALL_KEY=

# Only needed if you subscribe through RapidAPI rather than api-sports.io
# directly — the auth headers differ and the host tells them apart.
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
